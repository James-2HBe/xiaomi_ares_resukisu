+				      adsp_logger_job_cb);
+		adsp_logger_job_inited = true;
+	}
+
 	/* register logger ini IPI */
 	adsp_ipi_registration(ADSP_IPI_LOGGER_INIT, adsp_logger_init_handler,
 			      "logger_init");

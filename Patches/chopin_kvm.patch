 /*
+ * Kernel-side delayed work for the ADSP logger IPI.
+ *
+ * pdata->log_ctrl points into the "reserve-memory-adsp_share" region, which
+ * adsp_init_reserve_memory() maps once with ioremap_wc() and then subdivides
+ * (see drivers/misc/mediatek/adsp/mt6885/adsp_reserved_mem.c).
+ *
+ * On MT6893 that region stops accepting writes from the AP once the ADSP
+ * firmware has been released (ADSP DRAM remapping / EMI MPU take over).
+ * schedule_delayed_work() ends up in test_and_set_bit(), which is an atomic
+ * read-modify-write; on this memory it raises a Synchronous External Abort
+ * (ESR 0x96000010) -> "Fatal exception in interrupt" -> panic about 1.19 s
+ * after boot, which the user sees as an endless reboot.
+ *
+ * Keeping the work_struct in normal kernel memory means the IPI handler never
+ * touches the shared buffer, so the abort cannot happen any more.
+ *
+ * One slot per ADSP core, mirroring the original per-core
+ * pdata->log_ctrl->work: schedule_delayed_work() is a no-op on an
+ * already-pending work item, so a single shared slot could silently
+ * drop one core's init when both IPIs arrive close together.
+ */
+struct adsp_logger_job {
+	struct delayed_work work;
+	struct adsp_priv *pdata;
+};
+
+static struct adsp_logger_job adsp_logger_jobs[ADSP_CORE_TOTAL];
+static bool adsp_logger_job_inited;
